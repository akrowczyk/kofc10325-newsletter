# Copy to .env.local for local development. Everything here is OPTIONAL:
# with nothing set, the app runs on a local JSON store with no login — ideal
# for development. Set these in Vercel (not committed) for production.

# --- Author login -----------------------------------------------------------
# Set STUDIO_PASSWORD to turn on the password gate for the dashboard + editor.
# Published newsletters (/n/...) stay public either way. Leave unset locally.
STUDIO_PASSWORD=
# Secret used to sign the session cookie. Use a long random string in prod
# (e.g. `openssl rand -hex 32`). Falls back to STUDIO_PASSWORD if unset.
AUTH_SECRET=

# --- Email link -------------------------------------------------------------
# Public base URL of the deployed site, used for the "Read the newsletter"
# button in the Copy-email-HTML output. e.g. https://newsletter.kofc10325.org
# If unset, the app infers it from the request host.
NEXT_PUBLIC_SITE_URL=

# --- Member email notifications (Resend) ------------------------------------
# API key from resend.com. Enables the "Notify members" send feature. The
# "From" address (set in Council settings) must be on a domain you've verified
# in Resend (add its DNS records at Hostinger). See DEPLOY.md.
RESEND_API_KEY=

# --- Provisioned automatically by Vercel ------------------------------------
# These are injected by Vercel when you attach the integrations (see DEPLOY.md).
# Do not set them by hand in production.
#   POSTGRES_URL            -> Vercel Postgres (Neon): switches the store to the DB
#   BLOB_READ_WRITE_TOKEN   -> Vercel Blob: turns on photo uploads
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
